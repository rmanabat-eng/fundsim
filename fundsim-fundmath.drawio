<?xml version="1.0" encoding="UTF-8"?>
<mxfile host="drawio" version="26.0.0">
  <diagram name="Fund Math Scoring Logic">
    <mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1400" pageHeight="820" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- Column headers -->
        <mxCell id="h1" value="Per-Company Calculations" style="text;html=1;fontStyle=1;fontSize=14;align=left;" vertex="1" parent="1">
          <mxGeometry x="60" y="0" width="380" height="30" as="geometry" />
        </mxCell>
        <mxCell id="h2" value="Fund-Level Aggregation" style="text;html=1;fontStyle=1;fontSize=14;align=left;" vertex="1" parent="1">
          <mxGeometry x="560" y="0" width="380" height="30" as="geometry" />
        </mxCell>
        <mxCell id="h3" value="Time Series" style="text;html=1;fontStyle=1;fontSize=14;align=left;" vertex="1" parent="1">
          <mxGeometry x="1020" y="0" width="300" height="30" as="geometry" />
        </mxCell>

        <!-- A: input data -->
        <mxCell id="2" value="RoundInput[] per company&#xa;(date, raised, postMoney, yourCheck)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="60" y="40" width="380" height="80" as="geometry" />
        </mxCell>

        <!-- B: ownershipAfterRounds -->
        <mxCell id="3" value="ownershipAfterRounds()&#xa;Each round: dilute existing stake by&#xa;(post − raised) / post, then add yourCheck / post" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="60" y="160" width="380" height="90" as="geometry" />
        </mxCell>

        <!-- C & D -->
        <mxCell id="4" value="currentValue()&#xa;ownership × latest postMoney&#xa;→ unrealized paper value" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="60" y="300" width="180" height="90" as="geometry" />
        </mxCell>
        <mxCell id="5" value="exitProceeds()&#xa;ownership × exitValue&#xa;→ realized cash (write-off = exit@0)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="260" y="300" width="180" height="90" as="geometry" />
        </mxCell>

        <!-- E: companyCashFlows -->
        <mxCell id="6" value="companyCashFlows()&#xa;−check on each round date;&#xa;+exit proceeds (exited) or +current value &quot;as of&quot; (active)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="60" y="440" width="380" height="100" as="geometry" />
        </mxCell>

        <!-- F: xirr -->
        <mxCell id="7" value="xirr()&#xa;Bisection search for the rate where&#xa;NPV(rate) = 0 over dated cash flows" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="60" y="580" width="380" height="90" as="geometry" />
        </mxCell>

        <!-- G: companyIrr end -->
        <mxCell id="8" value="companyIrr()&#xa;Per-company IRR shown on the&#xa;company detail page" style="ellipse;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="60" y="710" width="380" height="70" as="geometry" />
        </mxCell>

        <!-- H: fundMetrics -->
        <mxCell id="9" value="fundMetrics(companies[])&#xa;Σ deployed, Σ portfolioValue, Σ distributions;&#xa;combine every company's cash flows → fund IRR" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1">
          <mxGeometry x="560" y="300" width="380" height="110" as="geometry" />
        </mxCell>

        <!-- I, J, K metrics -->
        <mxCell id="10" value="DPI&#xa;distributions&#xa;/ deployed" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="560" y="470" width="115" height="80" as="geometry" />
        </mxCell>
        <mxCell id="11" value="TVPI&#xa;(portfolioValue + distributions)&#xa;/ deployed" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="695" y="470" width="115" height="80" as="geometry" />
        </mxCell>
        <mxCell id="12" value="Fund IRR&#xa;xirr() on the&#xa;combined flows" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="830" y="470" width="115" height="80" as="geometry" />
        </mxCell>

        <!-- L: fundTimeline -->
        <mxCell id="13" value="fundTimeline(companies[])&#xa;Replay every dated round/exit event&#xa;chronologically, step-wise" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1">
          <mxGeometry x="1020" y="300" width="300" height="100" as="geometry" />
        </mxCell>

        <!-- M: chart data end -->
        <mxCell id="14" value="Dashboard chart data&#xa;{date, deployed, value, distributions}[]" style="ellipse;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="1020" y="470" width="300" height="70" as="geometry" />
        </mxCell>

        <!-- Per-company spine edges -->
        <mxCell id="20" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="2" target="3">
          <mxGeometry relative="1" as="geometry" />
