        <mxCell id="23" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.3;exitY=1;entryX=0.3;entryY=0;" edge="1" parent="1" source="4" target="6">
          <mxGeometry relative="1" as="geometry" />
