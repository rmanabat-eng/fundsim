<?xml version="1.0" encoding="UTF-8"?>
<mxfile host="drawio" version="26.0.0">
  <diagram name="Campaign Game Mode Flow">
    <mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1700" pageHeight="1250" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- Start -->
        <mxCell id="2" value="Start Campaign&#xa;startCampaign()" style="ellipse;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="560" y="40" width="240" height="60" as="geometry" />
        </mxCell>

        <!-- New year deal flow -->
        <mxCell id="3" value="New Year&#xa;dealFlow(year): deal a fresh batch of pitches" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="540" y="160" width="280" height="70" as="geometry" />
        </mxCell>

        <!-- Diamond 1: deal queue -->
        <mxCell id="4" value="Deal in queue?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="570" y="300" width="220" height="110" as="geometry" />
        </mxCell>

        <!-- Right branch: invest/pass -->
        <mxCell id="5" value="Invest or Pass&#xa;investInDeal(): spend capital, create Company + Round&#xa;— or —&#xa;passDeal(): discard" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1">
          <mxGeometry x="1020" y="290" width="300" height="110" as="geometry" />
        </mxCell>

        <!-- Diamond 2: decision pending -->
        <mxCell id="6" value="Decision pending?&#xa;(Term Sheet, Bridge Request, Acquisition Offer,&#xa;Exit Route, CEO Replacement, Pay-to-Play, Fund Secondary)" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="530" y="490" width="300" height="140" as="geometry" />
        </mxCell>

        <!-- Right branch: resolve decision -->
        <mxCell id="7" value="Resolve Decision&#xa;accept / decline / choose&#xa;(resolveTermSheet, acceptAcquisition, fundBridge,&#xa;resolveExitRoute, resolveCeoReplacement,&#xa;resolvePayToPlay, acceptFundSecondary, declineDecision)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1">
          <mxGeometry x="1000" y="480" width="340" height="140" as="geometry" />
        </mxCell>

        <!-- Advance year -->
        <mxCell id="8" value="Advance Year&#xa;advanceYear(): simulate rounds &amp; exits, roll market,&#xa;update reputation" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="540" y="700" width="280" height="80" as="geometry" />
        </mxCell>

        <!-- Diamond 3: end condition -->
        <mxCell id="9" value="Year == 10 or&#xa;fund wiped out?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="570" y="840" width="220" height="110" as="geometry" />
        </mxCell>

        <!-- Grade fund -->
        <mxCell id="10" value="gradeFund()&#xa;compute TVPI to letter grade" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="540" y="1000" width="280" height="70" as="geometry" />
        </mxCell>

        <!-- End -->
        <mxCell id="11" value="Campaign Complete&#xa;Fund Grade shown" style="ellipse;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="560" y="1110" width="240" height="60" as="geometry" />
        </mxCell>

        <!-- Main spine edges -->
        <mxCell id="20" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="2" target="3">
