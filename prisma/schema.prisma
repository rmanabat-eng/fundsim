// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Stage {
  PRE_SEED
  SEED
  SERIES_A
  SERIES_B
  SERIES_C
}

// An anonymous per-browser identity, assigned via cookie by src/proxy.ts on
// a visitor's first request. Deliberately the simplest possible identity —
// no email, no password, nothing recoverable. Clearing the cookie (or
// switching browsers/devices) permanently loses access to that visitor's
// fund; there is no login and no account recovery in this phase.
model Visitor {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
}

// Single-row-per-visitor: the fund's knobs.
model FundSettings {
  id           String @id @default(cuid())
  visitorId    String @unique
  fundSize     Float  @default(10000000)
  maxCompanies Int    @default(15)
}

// A named snapshot of the whole portfolio + settings, for comparing
// strategies. `data` is a JSON blob — scenarios are read-mostly.
model Scenario {
  id        String   @id @default(cuid())
  visitorId String
  name      String
  createdAt DateTime @default(now())
  data      String

  @@index([visitorId])
}

model Company {
  id            String     @id @default(cuid())
  visitorId     String
  name          String
  sector        String
  description   String     @default("") // cosmetic flavor text, never affects quality
  referredBy    String? // set when a founder with an earned track record referred this deal in
  createdAt     DateTime   @default(now())
  exitValue     Float? // company valuation at exit; 0 means written off; null = still active
  exitDate      DateTime?
  quality       Float      @default(0) // hidden -1..1; tilts campaign-mode outcomes. 0 for free-play companies.
  scenarioState String     @default("{}") // JSON CompanyDynState (src/lib/scenario-pool.ts) — chaining memory for the scenario pool, separate from quality
  dealId        String?    @unique // the pitch this company was funded from; lets a first check be undone before the year advances
  deal          Deal?      @relation(fields: [dealId], references: [id])
  rounds        Round[]
  decisions     Decision[]

  @@index([visitorId])
}

// ---- Campaign mode ----

// The running campaign — one row per visitor. No row means that visitor
// hasn't started a campaign.
model Game {
  id        String   @id @default(cuid())
  visitorId String   @unique
  year      Int      @default(1)
  status    String   @default("active") // "active" | "ended"
  market    String   @default("normal") // this year's conditions: "bull" | "normal" | "bear"
  startedAt DateTime @default(now())
}

// A pitch dealt to the player for one campaign year. `quality` is the hidden
// score its signals (noisily) encode — never shown, only its consequences.
model Deal {
  id          String  @id @default(cuid())
  visitorId   String
  year        Int
  name        String
  sector      String
  stage       Stage
  raised      Float
  postMoney   Float
  description String  @default("") // cosmetic flavor text, never affects quality
  referredBy  String? // set when a founder with an earned track record referred this deal in
  signals     String // JSON array of signal texts shown on the pitch card
  quality     Float
  status      String  @default("open") // "open" | "invested" | "passed" | "expired"
  company     Company? // set when invested; cleared if the investment is undone

  @@index([visitorId])
}

// A decision forced on the player: fund a pro-rata, take an acquisition
// offer, bridge a struggling company, or advise a founder (pick between
// term sheets, bless a pivot). Expires against the player if unresolved
// when the year advances.
model Decision {
  id        String  @id @default(cuid())
  visitorId String
  year      Int
  type      String // "pro_rata" | "acquisition" | "bridge" | "term_sheet" | "pivot" | "exit_route" | "ceo_replacement" | "pay_to_play"
  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  payload   String // JSON, shape depends on type
  // "pending" | "resolved" | "resolved_flattering" | "declined" |
  // "declined_costly" | "expired" | "moot" | "ousted" — "resolved_flattering"
  // and "declined_costly" exist purely to price reputation apart from their
  // plain counterparts (see reputation() in src/lib/campaign.ts), the same
  // way "ousted" already prices apart from "resolved".
  status    String  @default("pending")

  @@index([visitorId])
}

model Round {
  id        String   @id @default(cuid())
  visitorId String
  companyId String
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  stage     Stage
  date      DateTime
  raised    Float // total new money in the round
  postMoney Float // company valuation after the round closes
  yourCheck Float // your fund's participation; 0 if you sat the round out

  @@index([visitorId])
}
